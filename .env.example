# Copy this file to .env. Spring and Docker Compose both read it, so these
# local-only defaults match the database that `docker compose up` creates.
DB_URL=jdbc:postgresql://127.0.0.1:5432/todo
DB_USERNAME=postgres
DB_PASSWORD=todo-local-only
# Explicit local HTTP onboarding only. Use Secure cookies and disable open registration in deployment.
AUTH_REGISTRATION_ENABLED=true
SESSION_COOKIE_SECURE=false
# Verification emails (#71). Compose's Mailpit needs none of these; set them for a real SMTP server.
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_FROM=no-reply@salem-todo.local
# AUTH_VERIFICATION_URL=http://127.0.0.1:3000/verify-email
# System administrators by email, comma-separated. The Postman folder 11 Administration uses this one.
# ADMIN_EMAILS=postman-admin@example.com
# Local development only. Uncomment to stop repeated Postman runs from one machine
# being throttled. Never use these on a server: the defaults in application.properties apply.
# app.rate-limit.login-per-address.max=1000
# app.rate-limit.register-per-address.max=1000
# app.rate-limit.sessions-per-address.max=1000
# app.rate-limit.password-change-per-address.max=1000
