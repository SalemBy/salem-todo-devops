# Copy this file to .env. Spring and Docker Compose both read it, so these
# local-only defaults match the database that `docker compose up` creates.
DB_URL=jdbc:postgresql://127.0.0.1:5432/todo
DB_USERNAME=postgres
DB_PASSWORD=todo-local-only
# Explicit local HTTP onboarding only. Use Secure cookies and disable open registration in deployment.
AUTH_REGISTRATION_ENABLED=true
SESSION_COOKIE_SECURE=false
